# ============================================================
# Anniversary site environment variables
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must NEVER be committed.
#
# Cloudinary credentials are server-only. They must NEVER be exposed
# to the browser, NEVER prefixed with NEXT_PUBLIC_, and NEVER
# committed to Git.
# ============================================================

# --- Cloudinary: server-only (NEVER expose to the browser or Git) ---
# Find these in the Cloudinary Console -> Dashboard:
#   Account Details -> Cloud name
#   Account Details -> API Key
#   Account Details -> API Secret
CLOUDINARY_CLOUD_NAME=

CLOUDINARY_API_KEY=

CLOUDINARY_API_SECRET=