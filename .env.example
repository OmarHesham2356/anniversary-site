# ============================================================
# Anniversary site environment variables
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must NEVER be committed.
#
# Cloudinary credentials are server-only. They must NEVER be exposed
# to the browser, NEVER prefixed with NEXT_PUBLIC_, and NEVER
# committed to Git.
# ============================================================

# --- Cloudinary: server-only (NEVER expose to the browser or Git) ---
# Find these in the Cloudinary Console -> Dashboard:
#   Account Details -> Cloud name
#   Account Details -> API Key
#   Account Details -> API Secret
CLOUDINARY_CLOUD_NAME=

CLOUDINARY_API_KEY=

CLOUDINARY_API_SECRET=

# --- Relationship content: build-time secrets (NEVER commit to Git) ---
# On deployment platforms that build from a git clone (e.g. Vercel), the
# gitignored `config/anniversaryData.ts` is not available. Serialize the
# whole config as JSON and paste it into this variable instead. It is
# resolved in priority order over the local file at build/runtime:
#
#   1. ANNIVERSARY_DATA_JSON (this variable)
#   2. config/anniversaryData.ts (local, gitignored)
#   3. config/anniversaryData.example.ts (placeholder)
#
# Generate it locally with:
#
#   node --experimental-strip-types -e \
#     "import('./config/anniversaryData.ts').then(m => console.log(JSON.stringify(m.anniversaryData)))"
#
# Example shape (same object as config/anniversaryData.ts):
#   {"couple":{"personOne":"...","personTwo":"..."},"relationship":{"startDate":"..."},"timeline":[...],"gallery":[...],"music":{"publicId":"..."},"letter":{"greeting":"...","paragraphs":[...],"signature":"..."}}
ANNIVERSARY_DATA_JSON=